# Ad and analytics tags. Each tag stays off until its ID is set.
# Set these in Vercel (Project > Settings > Environment Variables) for Production.

# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Ads tag ID, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Label of the "Consultation request" conversion action (the part after the slash in send_to)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta Pixel (dataset) ID, digits only
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------- staff portal
# The portal (/portal) shows "being set up" until the two NEXT_PUBLIC_SUPABASE
# values are set. Never commit real values; set them in Vercel.

# Supabase project URL and publishable (anon) key: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key (server only): staff invites and the shared rate limiter
SUPABASE_SERVICE_ROLE_KEY=
# Public site address, used in sign-in links and emails
NEXT_PUBLIC_APP_URL=https://www.ppimconsulting.co.nz
# Any long random string; Vercel Cron sends it to the keepalive endpoint
CRON_SECRET=
# Optional: emails from the portal (invites, returned time, leave) via Resend.
# Without these, sign-in links are shown on screen to pass on by hand.
RESEND_API_KEY=
EMAIL_FROM=
